{
  "name": "enaga",
  "version": "0.1.0",
  "private": true,
  "description": "Markdown の原稿から、路線図のある静的な教材サイトを作るツール",
  "type": "module",
  "bin": {
    "enaga": "src/cli.js"
  },
  "files": [
    "src",
    "tests"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node src/cli.js build --content tests/fixtures/content",
    "dev": "node src/cli.js dev --content tests/fixtures/content",
    "test": "node --test \"tests/**/!(dev).test.js\" && node --test tests/browser/dev.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "refs:verify": "node src/cli.js refs:verify --content tests/fixtures/content"
  },
  "dependencies": {
    "esbuild": "0.28.2",
    "js-yaml": "5.5.0",
    "katex": "0.19.1",
    "markdown-it": "14.3.3",
    "markdown-it-container": "4.0.0",
    "playwright": "1.64.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  }
}
